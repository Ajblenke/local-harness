{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-harness/completion/v1",
  "title": "Local Harness Agent Completion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "work_order_sha256", "agent_id", "status", "summary", "changes", "checks", "claims", "risks", "uncertainties", "requested_action"],
  "properties": {
    "schema": {"const": "local-harness/completion/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "work_order_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "blocked", "needs_review"]},
    "summary": {"type": "string", "minLength": 1},
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "kind"], "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"enum": ["added", "modified", "deleted", "renamed"]}}}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "skipped"]}}}},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence_refs"], "properties": {"statement": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "risks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["level", "detail"], "properties": {"level": {"enum": ["low", "medium", "high", "critical"]}, "detail": {"type": "string", "minLength": 1}}}},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requested_action": {"enum": ["advance", "double_check"]}
  }
}
