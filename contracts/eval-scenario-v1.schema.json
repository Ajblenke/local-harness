{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-harness/eval-scenario/v1",
  "title": "Local Harness Evaluation Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "system", "tools", "cases"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "system": {"type": "string", "minLength": 1},
    "tools": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "prompt", "expect_calls"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "tool_results": {"type": "object", "additionalProperties": {"type": "string"}},
          "expect_calls": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["tool", "args"], "properties": {"tool": {"type": "string", "minLength": 1}, "args": {"type": "object"}}}},
          "allow_extra_calls": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "max_turns": {"type": "integer", "minimum": 1},
          "max_repeat_calls": {"type": "integer", "minimum": 1},
          "expect_final_contains": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expect_final_contains_any": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
