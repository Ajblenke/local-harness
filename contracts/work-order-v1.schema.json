{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-harness/work-order/v1",
  "title": "Local Harness Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "objective", "base_commit", "scope", "required_checks", "limits", "approval", "next_step"],
  "properties": {
    "schema": {"const": "local-harness/work-order/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "objective": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "deny"],
      "properties": {
        "read": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "write": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "deny": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_changed_files", "max_changed_files", "max_tool_calls", "max_wall_seconds"],
      "properties": {
        "min_changed_files": {"type": "integer", "minimum": 0},
        "max_changed_files": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "approval": {"const": "human"},
    "next_step": {"type": "string", "minLength": 1}
  }
}
