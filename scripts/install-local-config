#!/usr/bin/env bash
# Install the reviewed local-only runtime configuration into the current account.
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PI_MODELS_LINK="${PI_MODELS_FILE:-$HOME/.pi/agent/models.json}"
PI_SETTINGS_LINK="${PI_SETTINGS_FILE:-$HOME/.pi/agent/settings.json}"
ROUTER_PRESET_LINK="${LLM_PRESET:-$HOME/.config/llama-router/models.ini}"
LLM_SERVE_LINK="${LLM_SERVE_FILE:-$HOME/.local/bin/llm-serve}"
BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/local-harness/config-backups"

usage() {
    cat <<EOF
Usage: scripts/install-local-config [--apply]

Without --apply, show the source and resolved destination paths. With --apply,
back up existing files privately and install the local-only serial model baseline
(Qwen 128K or MiniCPM5 32K, with one model loaded at a time).
Gemini credentials are never read or written by this script.
EOF
}

resolved_destination() {
    local path="$1"
    if [[ -L "$path" ]]; then
        readlink -f "$path"
    else
        printf '%s\n' "$path"
    fi
}

PI_MODELS_TARGET="$(resolved_destination "$PI_MODELS_LINK")"
PI_SETTINGS_TARGET="$(resolved_destination "$PI_SETTINGS_LINK")"
ROUTER_PRESET_TARGET="$(resolved_destination "$ROUTER_PRESET_LINK")"
LLM_SERVE_TARGET="$(resolved_destination "$LLM_SERVE_LINK")"

show_plan() {
    printf '%s -> %s\n' \
        "$ROOT/config/pi/models.json" "$PI_MODELS_TARGET" \
        "$ROOT/config/llama-router/models.ini" "$ROUTER_PRESET_TARGET" \
        "$ROOT/scripts/llm-serve" "$LLM_SERVE_TARGET"
    printf 'chmod 600 %s\n' "$PI_SETTINGS_TARGET"
}

safe_target() {
    local target="$1"
    [[ "$target" == "$HOME/"* && "$target" != "$HOME" ]]
}

backup_one() {
    local target="$1" backup_dir="$2"
    [[ -f "$target" ]] || return 0
    cp -p -- "$target" "$backup_dir/$(basename "$target").$(printf '%s' "$target" | sha256sum | cut -c1-12)"
}

install_one() {
    local source="$1" target="$2" mode="$3"
    mkdir -p "$(dirname "$target")"
    install -m "$mode" -- "$source" "$target"
}

case "${1:-}" in
    "") show_plan ;;
    --apply)
        for target in "$PI_MODELS_TARGET" "$PI_SETTINGS_TARGET" "$ROUTER_PRESET_TARGET" "$LLM_SERVE_TARGET"; do
            safe_target "$target" || {
                echo "refusing destination outside the current home: $target" >&2
                exit 2
            }
        done
        stamp="$(date -u +%Y%m%dT%H%M%SZ)"
        backup_dir="$BACKUP_ROOT/$stamp"
        mkdir -p "$backup_dir"
        chmod 700 "$BACKUP_ROOT" "$backup_dir"
        backup_one "$PI_MODELS_TARGET" "$backup_dir"
        backup_one "$PI_SETTINGS_TARGET" "$backup_dir"
        backup_one "$ROUTER_PRESET_TARGET" "$backup_dir"
        backup_one "$LLM_SERVE_TARGET" "$backup_dir"
        install_one "$ROOT/config/pi/models.json" "$PI_MODELS_TARGET" 600
        install_one "$ROOT/config/llama-router/models.ini" "$ROUTER_PRESET_TARGET" 600
        install_one "$ROOT/scripts/llm-serve" "$LLM_SERVE_TARGET" 755
        [[ -f "$PI_SETTINGS_TARGET" ]] && chmod 600 "$PI_SETTINGS_TARGET"
        echo "installed local-only configuration; backups: $backup_dir"
        ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 2 ;;
esac
